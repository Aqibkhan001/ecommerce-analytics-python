# Step 1 — get order month and each customer's first-purchase (cohort) month
df_master['order_month'] = df_master['order_purchase_timestamp'].dt.to_period('M')

df_master['cohort_month'] = df_master.groupby('customer_unique_id')['order_month'].transform('min')

print(df_master[['customer_unique_id', 'order_month', 'cohort_month']].head())
# Step 2 — cohort index = months since first purchase
def get_cohort_index(df):
    order_year = df['order_month'].dt.year
    order_mon = df['order_month'].dt.month
    cohort_year = df['cohort_month'].dt.year
    cohort_mon = df['cohort_month'].dt.month

    year_diff = order_year - cohort_year
    month_diff = order_mon - cohort_mon

    return year_diff * 12 + month_diff + 1   # +1 so first purchase = index 1

df_master['cohort_index'] = get_cohort_index(df_master)

print(df_master[['customer_unique_id', 'cohort_month', 'order_month', 'cohort_index']].head())
# Step 3 — count unique customers per cohort_month + cohort_index
cohort_data = df_master.groupby(['cohort_month', 'cohort_index'])['customer_unique_id'].nunique().reset_index()
cohort_data.columns = ['cohort_month', 'cohort_index', 'n_customers']

print(cohort_data.head(10))

# reshape into a matrix: rows = cohort_month, columns = cohort_index
