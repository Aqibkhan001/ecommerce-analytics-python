# Step 1 — Average Order Value (AOV) per customer
customer_orders = df_master.groupby('customer_unique_id').agg(
    total_revenue=('total_revenue', 'sum'),
    order_count=('order_id', 'nunique')
).reset_index()

customer_orders['AOV'] = customer_orders['total_revenue'] / customer_orders['order_count']

print(customer_orders.head())
print(customer_orders['AOV'].describe())
# Step 2 — Purchase frequency (raw order count) + first/last purchase dates
customer_dates = df_master.groupby('customer_unique_id').agg(
    first_purchase=('order_purchase_timestamp', 'min'),
    last_purchase=('order_purchase_timestamp', 'max')
).reset_index()

# merge into our running customer-level table
customer_orders = customer_orders.merge(customer_dates, on='customer_unique_id', how='left')

print(customer_orders.head())
# Step 3 — Customer lifespan in months
customer_orders['lifespan_days'] = (customer_orders['last_purchase'] - customer_orders['first_purchase']).dt.days
customer_orders['lifespan_months'] = customer_orders['lifespan_days'] / 30.44   # avg days per month

print(customer_orders[['customer_unique_id', 'order_count', 'lifespan_days', 'lifespan_months']].head())
print(customer_orders['lifespan_months'].describe())
# Step 4 — Calculate CLV per customer
# Give every customer a minimum lifespan of 1 month to avoid divide-by-zero
customer_orders['lifespan_adj'] = customer_orders['lifespan_months'].apply(lambda x: max(x, 1))

customer_orders['purchase_frequency'] = customer_orders['order_count'] / customer_orders['lifespan_adj']

customer_orders['CLV'] = customer_orders['AOV'] * customer_orders['purchase_frequency'] * customer_orders['lifespan_adj']

print(customer_orders[['customer_unique_id', 'AOV', 'order_count', 'lifespan_adj', 'purchase_frequency', 'CLV']].head(10))
print(customer_orders['CLV'].describe())

# sanity check — CLV should equal total_revenue for every customer with this formula
print((customer_orders['CLV'].round(2) == customer_orders['total_revenue'].round(2)).mean())
